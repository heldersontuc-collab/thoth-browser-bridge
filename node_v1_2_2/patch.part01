diff --git a/.env.example b/.env.example
index 79d5af3..e9d234f 100644
--- a/.env.example
+++ b/.env.example
@@ -1,6 +1,6 @@
 COMPOSE_FILE=docker-compose.yml
 COMPOSE_PROJECT_NAME=thoth-browser-node
-# THOTH Browser Node V1.2 - arquivo criado automaticamente pelo instalador.
+# THOTH Browser Node V1.2.2 AUDITED - arquivo criado automaticamente pelo instalador.
 THOTH_API_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
 THOTH_DATA_DIR=/data
 THOTH_BLOCK_PRIVATE_NETWORKS=true
@@ -27,8 +27,8 @@ CONTROL_PLANE_TUNNEL_ID=
 
 # Limites para proteger os outros sistemas desta VPS
 THOTH_BROWSER_MEM_LIMIT=1280m
-THOTH_API_MEM_LIMIT=384m
-THOTH_MCP_MEM_LIMIT=256m
-THOTH_PROXY_MEM_LIMIT=64m
-THOTH_CADDY_MEM_LIMIT=128m
+THOTH_API_MEM_LIMIT=256m
+THOTH_MCP_MEM_LIMIT=192m
+THOTH_PROXY_MEM_LIMIT=48m
+THOTH_CADDY_MEM_LIMIT=96m
 THOTH_TUNNEL_MEM_LIMIT=128m
diff --git a/README.md b/README.md
index 4b8bcaa..d724323 100644
--- a/README.md
+++ b/README.md
@@ -1,6 +1,6 @@
 > Ajustado para uma VPS já em produção. Esta edição evita as portas 80/443 e 8787, não reinicia serviços existentes e faz pré-teste de espaço/memória antes de subir qualquer container novo.
 
-# THOTH Browser Node V1.2.1 · VPS SAFE
+# THOTH Browser Node V1.2.2 AUDITED · VPS SAFE
 
 Um **Chromium persistente, visível no celular e controlável pelo ChatGPT**, hospedado 24/7 na VPS.
 
